<Window x:Class="CommunicationGame.Client.Windows.LogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Live Log" Height="400" Width="550"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <RichTextBox x:Name="RtbLog" Grid.Row="0" IsReadOnly="True"
                     VerticalScrollBarVisibility="Auto"
                     FontFamily="Consolas" FontSize="12">
            <RichTextBox.Resources>
                <Style TargetType="{x:Type Paragraph}">
                    <Setter Property="Margin" Value="0"/>
                </Style>
            </RichTextBox.Resources>
            <FlowDocument PagePadding="2"/>
        </RichTextBox>
        <Button x:Name="BtnClear" Grid.Row="1" Content="Clear" Width="80"
                HorizontalAlignment="Right" Margin="0,4,0,0"
                Click="BtnClear_Click"/>
    </Grid>
</Window>
