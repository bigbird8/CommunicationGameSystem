<Window x:Class="CommunicationGame.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Communication Game" 
        Height="680" Width="570"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#0D1117"
        Closing="Window_Closing">

    <Window.Resources>
        <!-- Shared label style -->
        <Style x:Key="GameLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#C9D1D9"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- Game button base -->
        <Style x:Key="GameBtn" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="18,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                Effect="{TemplateBinding Effect}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnConnect" TargetType="Button" BasedOn="{StaticResource GameBtn}">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#2563EB" Offset="0"/>
                        <GradientStop Color="#7C3AED" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#2563EB" BlurRadius="14" ShadowDepth="0" Opacity="0.4"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnPauseStyle" TargetType="Button" BasedOn="{StaticResource GameBtn}">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#F59E0B" Offset="0"/>
                        <GradientStop Color="#D97706" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#F59E0B" BlurRadius="10" ShadowDepth="0" Opacity="0.3"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnResumeStyle" TargetType="Button" BasedOn="{StaticResource GameBtn}">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#10B981" Offset="0"/>
                        <GradientStop Color="#059669" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#10B981" BlurRadius="10" ShadowDepth="0" Opacity="0.3"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnRestartStyle" TargetType="Button" BasedOn="{StaticResource GameBtn}">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#8B5CF6" Offset="0"/>
                        <GradientStop Color="#6D28D9" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#8B5CF6" BlurRadius="10" ShadowDepth="0" Opacity="0.3"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnDisconnectStyle" TargetType="Button" BasedOn="{StaticResource GameBtn}">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#EF4444" Offset="0"/>
                        <GradientStop Color="#DC2626" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnLogStyle" TargetType="Button" BasedOn="{StaticResource GameBtn}">
            <Setter Property="Background" Value="#374151"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Background" Value="#161B22"/>
            <Setter Property="Foreground" Value="#E6EDF3"/>
            <Setter Property="BorderBrush" Value="#30363D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush" Value="White"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20,20,22,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Row 0: Header -->
        <Border Grid.Row="0" CornerRadius="14" Padding="18" Margin="0,0,0,16">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#1E293B" Offset="0"/>
                    <GradientStop Color="#0F172A" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="2" Opacity="0.5"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Communication Game" Foreground="White" FontSize="22" FontWeight="Bold"/>
                    <TextBlock Text="Rehab pressure game client" Foreground="#8B949E" FontSize="12" Margin="0,2,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" CornerRadius="14" Padding="12,6" VerticalAlignment="Center">
                    <Border.Background>
                        <SolidColorBrush Color="#21262D"/>
                    </Border.Background>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StatusIndicator" Width="10" Height="10" Fill="#6E7681" Margin="0,0,8,0"/>
                        <TextBlock x:Name="TxtStatus" Text="Disconnected" Foreground="#8B949E" FontWeight="SemiBold" FontSize="12"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Row 1: Connection -->
        <Border Background="#161B22" CornerRadius="10" Padding="8" Margin="0,99,0,12" Grid.RowSpan="2">
            <StackPanel Orientation="Horizontal" Margin="0,0,-8,0">
                <TextBlock Text="Host:" Style="{StaticResource GameLabel}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox x:Name="TxtHost" Width="120" Text="127.0.0.1" Margin="0,0,12,0"/>
                <TextBlock Text="Port:" Style="{StaticResource GameLabel}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox x:Name="TxtPort" Width="60" Text="5000" Margin="0,0,14,0"/>
                <Button x:Name="BtnConnect" Content="Connect" Width="100" Style="{StaticResource BtnConnect}" Click="BtnConnect_Click"/>
                <Button x:Name="BtnDisconnect" Content="Disconnect" Width="110" Margin="8,0,0,0"
                        Style="{StaticResource BtnDisconnectStyle}" IsEnabled="False" Click="BtnDisconnect_Click"/>
            </StackPanel>
        </Border>

        <!-- Row 2: Pressure display -->
        <Border x:Name="PressureBorder" Grid.Row="2" Height="100" CornerRadius="14" Margin="0,0,0,14">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#21262D" Offset="0"/>
                    <GradientStop Color="#161B22" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="16" ShadowDepth="2" Opacity="0.4"/>
            </Border.Effect>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock x:Name="TxtPressure" Text="--" FontSize="48" FontWeight="Bold"
                           Foreground="White" HorizontalAlignment="Center"/>
                <TextBlock Text="Pressure" Foreground="#8B949E" FontSize="11" HorizontalAlignment="Center" Margin="0,-2,0,0"/>
            </StackPanel>
        </Border>

        <!-- Row 3: Timer bars -->
        <Border Grid.Row="3" Background="#161B22" CornerRadius="10" Padding="16,12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="50"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition Height="10"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Green" Foreground="#10B981" FontWeight="Bold" VerticalAlignment="Center"/>
                <ProgressBar x:Name="PbGreen" Grid.Row="0" Grid.Column="1" Maximum="30" Height="22" Foreground="#10B981" Background="#21262D"/>
                <TextBlock x:Name="TxtGreenTime" Grid.Row="0" Grid.Column="2" Text="0.0s" Foreground="#10B981" FontWeight="SemiBold"
                           HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Red" Foreground="#F87171" FontWeight="Bold" VerticalAlignment="Center"/>
                <ProgressBar x:Name="PbRed" Grid.Row="2" Grid.Column="1" Maximum="3" Height="22" Foreground="#EF4444" Background="#21262D"/>
                <TextBlock x:Name="TxtRedTime" Grid.Row="2" Grid.Column="2" Text="0.0s" Foreground="#F87171" FontWeight="SemiBold"
                           HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12"/>
            </Grid>
        </Border>

        <!-- Row 4: Game controls -->
        <Grid Grid.Row="4" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Button x:Name="BtnPause" Grid.Column="0" Content="⏸  Pause"
                    Style="{StaticResource BtnPauseStyle}" IsEnabled="False" Click="BtnPause_Click"/>
            <Button x:Name="BtnResume" Grid.Column="2" Content="▶  Resume"
                    Style="{StaticResource BtnResumeStyle}" IsEnabled="False" Click="BtnResume_Click"/>
            <Button x:Name="BtnRestart" Grid.Column="4" Content="↻  Restart"
                    Style="{StaticResource BtnRestartStyle}" IsEnabled="False" Click="BtnRestart_Click"/>
        </Grid>

        <!-- Row 5: Result text -->
        <TextBlock x:Name="TxtResult" Grid.Row="5" FontSize="22" FontWeight="Bold"
                   HorizontalAlignment="Center" Margin="0,0,0,10" Foreground="White"/>

        <!-- Row 6: Mini log (inline) -->
        <Border Grid.Row="6" Background="#0D1117" CornerRadius="8" BorderBrush="#21262D" BorderThickness="1" Padding="4" Margin="0,0,0,8">
            <RichTextBox x:Name="RtbMiniLog" IsReadOnly="True"
                         VerticalScrollBarVisibility="Auto"
                         FontFamily="Consolas" FontSize="11"
                         Background="Transparent" Foreground="#7EE787"
                         BorderThickness="0" Padding="6">
                <RichTextBox.Resources>
                    <Style TargetType="{x:Type Paragraph}">
                        <Setter Property="Margin" Value="0"/>
                    </Style>
                </RichTextBox.Resources>
                <FlowDocument PagePadding="0"/>
            </RichTextBox>
        </Border>

        <!-- Row 7: Footer with log button -->
        <Grid Grid.Row="7">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Connect to the server to begin playing." Foreground="#484F58" VerticalAlignment="Center" FontSize="11"/>
            <Button x:Name="BtnLog" Grid.Column="1" Content="Open Full Log" Style="{StaticResource BtnLogStyle}" Click="BtnLog_Click"/>
        </Grid>
    </Grid>
</Window>
